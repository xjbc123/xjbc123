#!name=bilibili去广告(>=iOS15 修复版)
#!desc=解除部分视频后台限制,开屏页广告,推荐页广告,动态(最常访问/推荐话题/列表广告),视频播放页面(up主推荐广告,相关推荐广告),修复评论区加载失败问题
#!openUrl=https://github.com/app2smile/rules

[Mitm]
hostname = app.bilibili.com, grpc.biliapi.net

[Script]
# 换成你修改后的 bilibili-json.js 路径
http-response ^https:\/\/app\.bilibili\.com\/x\/(v2\/(splash\/(list|show)|feed\/index)|resource\/show\/tab\/v2) script-path=https://raw.githubusercontent.com/xjbc123/xjbc123/refs/heads/main/BiliBili/Bilibili.conf/_end_/Bilibili.pluginbilibili-json.js, requires-body=true, timeout=10, tag=bili-json
# 换成你修改后的 bilibili-proto.js 路径
http-response ^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(view\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll|playurl\.v1\.PlayURL\/PlayView)$ script-path=https://你的gist链接/raw/bilibili-proto.js, requires-body=true, binary-body-mode=true, timeout=10, tag=bili-proto